---
// Einfache Seiten (Startseite, Impressum, Datenschutz, 404): Himmel mit Titel (und Zurück-Button außer auf der
// Startseite), darunter der Inhalt auf Papier.
import BaseLayout from './BaseLayout.astro';
import SubHero from '../components/SubHero.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string; // Seitentitel im Browser-Tab; ohne Titel der Name der Seite
  heading?: string; // Überschrift auf der Seite, falls anders als der Titel
  description?: string;
  noindex?: boolean;
  home?: boolean; // Startseite: kein Zurück-Button
}
const { title, heading = title ?? '', description, noindex, home = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <SubHero title={heading} back={!home} />
  <div class="grass-edge" aria-hidden="true"></div>
  <main id="inhalt" tabindex="-1" class="ground">
    <div class="doc">
      <article class="entry pxbox paper">
        <div class="prose">
          <slot />
        </div>
      </article>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
